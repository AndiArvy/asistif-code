{
  "57fd9dfaa08f9a950456b737f1844685": {
    "text": "Remote terlihat. Tahan posisi Anda sebentar...",
    "filename": "57fd9dfaa08f9a950456b737f1844685.mp3",
    "hash": "57fd9dfaa08f9a950456b737f1844685"
  },
  "f51bc908cc8d8d24b993409ff87a64c3": {
    "text": "Posisinya pas. Silakan tekan tombolnya.",
    "filename": "f51bc908cc8d8d24b993409ff87a64c3.mp3",
    "hash": "f51bc908cc8d8d24b993409ff87a64c3"
  },
  "410e2458603cab88d03390ea5790c82d": {
    "text": "Remote tidak terlihat di kamera. Arahkan kembali.",
    "filename": "410e2458603cab88d03390ea5790c82d.mp3",
    "hash": "410e2458603cab88d03390ea5790c82d"
  },
  "9bd53efcf79eff19d914592d9042333f": {
    "text": "Jempol Anda belum terlihat di atas remote. Silakan raba perlahan.",
    "filename": "9bd53efcf79eff19d914592d9042333f.mp3",
    "hash": "9bd53efcf79eff19d914592d9042333f"
  },
  "81683331cb9236df55499a6e93bd5cff": {
    "text": "Layout direset. Letakkan remote di depan kamera.",
    "filename": "81683331cb9236df55499a6e93bd5cff.mp3",
    "hash": "81683331cb9236df55499a6e93bd5cff"
  },
  "0de49c2533ae735b0bfc3e724e91975a": {
    "text": "Pemetaan remote berhasil. Mau saya bantu apa?",
    "filename": "0de49c2533ae735b0bfc3e724e91975a.mp3",
    "hash": "0de49c2533ae735b0bfc3e724e91975a"
  },
  "bbce0a5ce6dc2db51e1cd8dafc99ed80": {
    "text": "Geser jempol Anda ke atas.",
    "filename": "bbce0a5ce6dc2db51e1cd8dafc99ed80.mp3",
    "hash": "bbce0a5ce6dc2db51e1cd8dafc99ed80"
  },
  "922157338be1ed082263684f5a5ca37d": {
    "text": "Geser jempol Anda ke bawah.",
    "filename": "922157338be1ed082263684f5a5ca37d.mp3",
    "hash": "922157338be1ed082263684f5a5ca37d"
  },
  "c28229b83349dc9dad5045bcb4fe8db5": {
    "text": "Geser jempol Anda ke kiri.",
    "filename": "c28229b83349dc9dad5045bcb4fe8db5.mp3",
    "hash": "c28229b83349dc9dad5045bcb4fe8db5"
  },
  "8cff044e00aa31644f8deeeb54280235": {
    "text": "Geser jempol Anda ke kanan.",
    "filename": "8cff044e00aa31644f8deeeb54280235.mp3",
    "hash": "8cff044e00aa31644f8deeeb54280235"
  },
  "8f578547cd77a38b4b62082914adaba9": {
    "text": "Geser jempol Anda ke atas lalu ke kanan.",
    "filename": "8f578547cd77a38b4b62082914adaba9.mp3",
    "hash": "8f578547cd77a38b4b62082914adaba9"
  },
  "2e05bc70b35b8612daec8ff37ce66202": {
    "text": "Geser jempol Anda ke bawah lalu ke kiri.",
    "filename": "2e05bc70b35b8612daec8ff37ce66202.mp3",
    "hash": "2e05bc70b35b8612daec8ff37ce66202"
  },
  "74887a5f4ce5f5e1bc9e6a5e4cd19659": {
    "text": "Memulai pemetaan remote.",
    "filename": "74887a5f4ce5f5e1bc9e6a5e4cd19659.mp3",
    "hash": "74887a5f4ce5f5e1bc9e6a5e4cd19659"
  },
  "a2988ab4cb360d8bdb2045f88208dcc8": {
    "text": "Mengambil gambar jernih...",
    "filename": "a2988ab4cb360d8bdb2045f88208dcc8.mp3",
    "hash": "a2988ab4cb360d8bdb2045f88208dcc8"
  },
  "576e243a4bed76b2f18925a223345067": {
    "text": "Memetakan fungsi tombol AC...",
    "filename": "576e243a4bed76b2f18925a223345067.mp3",
    "hash": "576e243a4bed76b2f18925a223345067"
  },
  "da5f4d5fd86d8c92f41c514114f03641": {
    "text": "Menganalisis posisi dan perintah...",
    "filename": "da5f4d5fd86d8c92f41c514114f03641.mp3",
    "hash": "da5f4d5fd86d8c92f41c514114f03641"
  }
}